<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.transform.Scale?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>


<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bloodlink.controller.RegisterController"
           styleClass="auth-background"
           stylesheets="@../css/theme.css"
           prefWidth="1000" prefHeight="760">

    <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
        <VBox alignment="TOP_CENTER">
            <padding><Insets top="32" bottom="32"/></padding>

            <VBox spacing="20" maxWidth="600">

                <VBox spacing="6" alignment="CENTER">
                    <!-- Same empty logo slot as the sidebar and sign-in. -->
                    <HBox fx:id="brandRow" alignment="CENTER"/>
                    <Label text="Create your BloodLink account" styleClass="page-title"/>
                    <Label fx:id="registerSubtitleLabel" text="Your contact details stay private until you accept a request."
                           styleClass="helper-text" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Progress indicator. The form is one scroll rather than a wizard,
                     so these mark how far through the sections you are. Built in the
                     controller rather than here because the number of sections depends
                     on the role: a requester has no health section and so has no third
                     step to show. -->
                <HBox fx:id="stepBar" spacing="0" alignment="CENTER"/>

                <VBox spacing="6">
                    <Label text="I WANT TO REGISTER AS" styleClass="field-label"/>
                    <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
                </VBox>

                <!-- 1. Personal Information -->
                <VBox styleClass="content-card" spacing="14">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                    <HBox spacing="9" alignment="CENTER_LEFT">
                        <Group>
                            <SVGPath content="M12,3.4 A4.3,4.3 0 1 0 12,12 A4.3,4.3 0 1 0 12,3.4 Z M12,13.8 C7.6,13.8 4,16.5 4,20.1 V21.2 H20 V20.1 C20,16.5 16.4,13.8 12,13.8 Z" styleClass="stat-icon" fillRule="EVEN_ODD">
                                <transforms><Scale x="0.72" y="0.72"/></transforms>
                            </SVGPath>
                        </Group>
                        <Label text="Identity" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="step1Label" text="STEP 1 OF 3" styleClass="field-label"/>
                    </HBox>
                    
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <StackPane>
                            <Label fx:id="profileInitialsLabel" text="?" styleClass="avatar-initials" visible="true"/>
                            <ImageView fx:id="profilePhotoView" fitWidth="84" fitHeight="84" visible="false" styleClass="avatar-photo" preserveRatio="false"/>
                        </StackPane>
                        <VBox spacing="8" alignment="CENTER_LEFT">
                            <Button text="Upload Photo" onAction="#uploadPhoto" styleClass="button-secondary"/>
                            <Button text="Remove" onAction="#removePhoto" styleClass="button-ghost"/>
                        </VBox>
                    </HBox>
                    
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="FULL NAME" styleClass="field-label"/>
                            <TextField fx:id="fullNameField"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="DATE OF BIRTH" styleClass="field-label"/>
                            <DatePicker fx:id="birthDatePicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="BLOOD GROUP" styleClass="field-label"/>
                            <ComboBox fx:id="bloodGroupCombo" maxWidth="Infinity" promptText="Select blood group"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="NID NUMBER" styleClass="field-label"/>
                            <PasswordField fx:id="nidNumberField" promptText="Optional"/>
                        </VBox>
                    </GridPane>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button fx:id="scanNidButton" text="Scan NID Card" styleClass="button-secondary" onAction="#scanNid"/>
                        <Label text="Auto-fill with NID scan" styleClass="helper-text"/>
                    </HBox>
                </VBox>

                <!-- 2. Contact Information -->
                <VBox styleClass="content-card" spacing="14">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                    <HBox spacing="9" alignment="CENTER_LEFT">
                        <Group>
                            <SVGPath content="M2.4,5.2 H21.6 V18.8 H2.4 Z M4.6,7.3 L12,13.1 L19.4,7.3 L19.4,9.5 L12,15.3 L4.6,9.5 Z" styleClass="stat-icon" fillRule="EVEN_ODD">
                                <transforms><Scale x="0.72" y="0.72"/></transforms>
                            </SVGPath>
                        </Group>
                        <Label text="Contact &amp; Access" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="step2Label" text="STEP 2 OF 3" styleClass="field-label"/>
                    </HBox>
                    
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="EMAIL" styleClass="field-label"/>
                            <TextField fx:id="emailField" promptText="you@example.com"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="PHONE" styleClass="field-label"/>
                            <TextField fx:id="phoneField"/>
                        </VBox>
                        
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="GUARDIAN NAME" styleClass="field-label"/>
                            <TextField fx:id="guardianNameField" promptText="Optional"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="GUARDIAN PHONE" styleClass="field-label"/>
                            <TextField fx:id="guardianPhoneField" promptText="Optional"/>
                        </VBox>
                        
                        <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Label text="DISTRICT" styleClass="field-label"/>
                            <TextField fx:id="districtField"/>
                        </VBox>
                        
                        <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Label text="FULL ADDRESS" styleClass="field-label"/>
                            <TextArea fx:id="addressArea" prefRowCount="2" wrapText="true" promptText="Optional"/>
                        </VBox>
                        
                        <VBox spacing="6" GridPane.rowIndex="4" GridPane.columnIndex="0">
                            <Label text="PASSWORD" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <Label text="CONFIRM PASSWORD" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- 3. Health & Eligibility -->
                <VBox fx:id="donorFields" styleClass="content-card" spacing="14">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                    <HBox spacing="9" alignment="CENTER_LEFT">
                        <Group>
                            <SVGPath content="M12,21.2 C12,21.2 2.8,15 2.8,8.9 A4.9,4.9 0 0 1 12,6.2 A4.9,4.9 0 0 1 21.2,8.9 C21.2,15 12,21.2 12,21.2 Z" styleClass="stat-icon" fillRule="EVEN_ODD">
                                <transforms><Scale x="0.72" y="0.72"/></transforms>
                            </SVGPath>
                        </Group>
                        <Label text="Health &amp; Eligibility" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="STEP 3 OF 3" styleClass="field-label"/>
                    </HBox>
                    
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="WEIGHT (KG)" styleClass="field-label"/>
                            <TextField fx:id="weightField"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="HEIGHT (CM)" styleClass="field-label"/>
                            <TextField fx:id="heightField" promptText="Optional"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <Label text="LAST DONATION" styleClass="field-label"/>
                            <DatePicker fx:id="lastDonationPicker" maxWidth="Infinity"/>
                        </VBox>
                    </GridPane>

                    <Label text="Medical Screening" styleClass="field-label" style="-fx-padding: 10 0 0 0;"/>
                    
                    <!-- Chronic conditions -->
                    <VBox spacing="6">
                        <Label text="Chronic conditions (if any)" styleClass="helper-text"/>
                        <TextField fx:id="chronicConditionsField" promptText="e.g. Diabetes, Hypertension..."/>
                    </VBox>

                    <!-- Recent Surgery -->
                    <VBox spacing="6">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Recent surgery (last 6 months)?" styleClass="helper-text" prefWidth="250"/>
                            <CheckBox fx:id="recentSurgeryCheck"/>
                        </HBox>
                        <TextField fx:id="recentSurgeryDetailsField" promptText="Please specify" managed="false" visible="false"/>
                    </VBox>
                    
                    <!-- Recent Tattoo -->
                    <VBox spacing="6">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Recent tattoo/piercing (last 6 months)?" styleClass="helper-text" prefWidth="250"/>
                            <CheckBox fx:id="recentTattooCheck"/>
                        </HBox>
                        <TextField fx:id="recentTattooDetailsField" promptText="Please specify" managed="false" visible="false"/>
                    </VBox>

                    <!-- Current Medications -->
                    <VBox spacing="6">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Currently taking medications?" styleClass="helper-text" prefWidth="250"/>
                            <CheckBox fx:id="currentMedicationsCheck"/>
                        </HBox>
                        <TextField fx:id="currentMedicationsDetailsField" promptText="Please specify" managed="false" visible="false"/>
                    </VBox>
                    
                    <!-- Recent Illness -->
                    <VBox spacing="6">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Recent infectious illness?" styleClass="helper-text" prefWidth="250"/>
                            <CheckBox fx:id="recentIllnessCheck"/>
                        </HBox>
                        <TextField fx:id="recentIllnessDetailsField" promptText="Please specify" managed="false" visible="false"/>
                    </VBox>

                    <!-- Recent Pregnancy -->
                    <VBox spacing="6">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Pregnancy in last 6 months?" styleClass="helper-text" prefWidth="250"/>
                            <CheckBox fx:id="recentPregnancyCheck"/>
                        </HBox>
                        <TextField fx:id="recentPregnancyDetailsField" promptText="Please specify" managed="false" visible="false"/>
                    </VBox>

                    <!-- Medical documents. Required: an administrator reads these
                         before approving the account. -->
                    <VBox spacing="10" style="-fx-padding: 14 0 0 0;">
                        <Label text="Medical report or prescription" styleClass="field-label"/>
                        <Label text="Attach at least one recent report or prescription. An administrator reviews it before your account is approved; nobody else can see it."
                               styleClass="helper-text" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="addDocumentButton" text="Attach a file" styleClass="button-secondary"
                                    onAction="#addMedicalDocument"/>
                            <Label fx:id="documentHintLabel" styleClass="helper-text"/>
                        </HBox>
                        <VBox fx:id="documentListHost" spacing="6"/>
                    </VBox>

                </VBox>

                <VBox spacing="8" alignment="CENTER">
                    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
                    <Button fx:id="createButton" text="Create Account" styleClass="button-primary" maxWidth="Infinity" onAction="#createAccount"/>
                    <HBox spacing="6" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                        <Label text="Already have an account?" styleClass="helper-text"/>
                        <Button text="Back to sign in" styleClass="button-ghost" onAction="#backToLogin"/>
                    </HBox>
                </VBox>
                
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
