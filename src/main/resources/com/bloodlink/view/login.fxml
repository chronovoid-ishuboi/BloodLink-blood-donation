<?xml version="1.0" encoding="UTF-8"?>

<!--
  Sign in, rebuilt in the shell's visual language: a full-height deep green
  brand panel carrying display type and an ImageSlot, against a clean form
  column. No card floating on a gradient: the two planes meet edge to edge,
  the way the reference layouts split their hero.

  Artwork: drop login-art.jpg into resources/com/bloodlink/images/ to fill
  the slot in the left panel.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bloodlink.controller.LoginController"
      styleClass="app-shell"
      stylesheets="@../css/theme.css"
      prefWidth="1100" prefHeight="740">

    <!-- Brand panel -->
    <VBox styleClass="auth-panel" prefWidth="520" spacing="20">
        <padding><Insets top="54" right="48" bottom="44" left="48"/></padding>

        <!-- Logo slot, same size and same empty-until-supplied behaviour as
             the one in the sidebar. Drop in images/company-logo.png. -->
        <HBox fx:id="brandRow" spacing="12" alignment="CENTER_LEFT">
            <Label text="BloodLink" styleClass="auth-wordmark"/>
        </HBox>

        <Region prefHeight="26"/>

        <!-- The animated pulse mark stands where the artwork slot used to. -->
        <VBox fx:id="loginArtHost" spacing="10"/>

        <Label text="BloodLink connects verified donors to real emergencies nearby, in the minutes that matter."
               styleClass="hero-sub" wrapText="true"/>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox fx:id="authStatsHost" spacing="30"/>
    </VBox>

    <!-- Form column -->
    <StackPane styleClass="auth-form-side" HBox.hgrow="ALWAYS">
        <VBox maxWidth="400" spacing="16" alignment="CENTER_LEFT">

            <Label text="Welcome back" styleClass="display-md"/>
            <Label text="Sign in to continue to your workspace." styleClass="section-head-sub"/>

            <Region prefHeight="6"/>

            <VBox spacing="6">
                <Label text="I AM A" styleClass="field-label"/>
                <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="EMAIL" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="you@example.com"/>
            </VBox>

            <VBox spacing="6">
                <Label text="PASSWORD" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Password"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>

            <Button fx:id="signInButton" text="Sign in" styleClass="button-pill"
                    maxWidth="Infinity" onAction="#signIn"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="New to BloodLink?" styleClass="section-head-sub"/>
                <Button text="Create an account" styleClass="button-ghost" onAction="#openRegistration"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
