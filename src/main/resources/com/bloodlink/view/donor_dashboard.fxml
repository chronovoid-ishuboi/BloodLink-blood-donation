<?xml version="1.0" encoding="UTF-8"?>

<!--
  Donor workspace, rebuilt on the sidebar shell.

  The TabPane this screen used to be is gone. Navigation is the NavRail the
  controller injects into navRailHost, and each destination is one full page
  inside the PageHost below, swapped with a slide-and-fade. Every page owns
  its own scroll area so it keeps its position when you navigate away and
  back, and the pages that lead with a hero let it run full-bleed to the
  window edges with the content cards overlapping its lower edge.

  Artwork: every photo the layout expects is an ImageSlot built in the
  controller. Drop files into resources/com/bloodlink/images/ using the names
  the placeholders print on screen and they appear on the next run.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.web.WebView?>
<?import com.bloodlink.view.shell.PageHost?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bloodlink.controller.DonorDashboardController"
      styleClass="app-shell"
      stylesheets="@../css/theme.css"
      prefWidth="1380" prefHeight="860">

    <!-- The NavRail component is built in Java (it owns a sliding highlight
         that CSS cannot express) and dropped in here. -->
    <StackPane fx:id="navRailHost"/>

    <PageHost fx:id="pageHost" HBox.hgrow="ALWAYS">

        <!-- ============================ 0 · HOME ============================ -->
        <ScrollPane fx:id="pageHome" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">

                <VBox fx:id="homeHeroHost"/>

                <!-- Metric cards overlapping the hero's lower edge. -->
                <HBox fx:id="homeMetricsRow" spacing="18" styleClass="hero-overlap">
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="BLOOD GROUP" styleClass="metric-label"/>
                        <Label fx:id="bloodGroupLabel" text="—" styleClass="metric-value, metric-value-blood"/>
                    </VBox>
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="DONOR TIER" styleClass="metric-label"/>
                        <Label fx:id="badgeLabel" text="—" styleClass="metric-value, metric-value-sm"/>
                    </VBox>
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="ELIGIBILITY" styleClass="metric-label"/>
                        <Label fx:id="eligibilityLabel" text="—" styleClass="metric-value, metric-value-sm"/>
                    </VBox>
                    <VBox styleClass="surface-card-tint" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="REWARD POINTS" styleClass="metric-label"/>
                        <Label fx:id="homePointsLabel" text="—" styleClass="metric-value, metric-value-sm"/>
                    </VBox>
                </HBox>

                <VBox styleClass="page-gutter">
                    <VBox fx:id="homeLocationHost"/>

                    <VBox fx:id="homeActionsHost" spacing="14"/>

                    <HBox spacing="22">
                        <VBox styleClass="surface-card" spacing="14" HBox.hgrow="ALWAYS">
                            <Label text="Donation cooldown" styleClass="section-head-title"/>
                            <Label fx:id="cooldownLabel" text="—" styleClass="section-head-sub" wrapText="true"/>
                            <ProgressBar fx:id="cooldownProgress" maxWidth="Infinity" prefHeight="10"/>
                            <Label text="Availability" styleClass="section-head-title"/>
                            <ComboBox fx:id="availabilityCombo" maxWidth="280" promptText="Set your availability"/>
                        </VBox>
                        <VBox fx:id="homeImpactHost" styleClass="surface-card" spacing="14" prefWidth="420"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>

        <!-- ========================== 1 · REQUESTS ========================== -->
        <ScrollPane fx:id="pageRequests" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="requestsHeroHost"/>
                <VBox styleClass="page-gutter" spacing="18">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Accept" styleClass="button-pill" onAction="#acceptSelected"/>
                        <Button text="Confirm Donated" styleClass="button-pill" onAction="#confirmDonated"/>
                        <Button text="Decline" styleClass="button-danger-outline" onAction="#declineSelected"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Set my exact location" styleClass="button-ghost" onAction="#setExactLocation"/>
                        <Button text="Detect my area" styleClass="button-ghost" onAction="#detectArea"/>
                    </HBox>
                    <HBox spacing="18">
                        <VBox styleClass="surface-card" spacing="12" prefWidth="520">
                            <Label text="Requests waiting for you" styleClass="section-head-title"/>
                            <ListView fx:id="matchList" styleClass="card-list" prefHeight="470"/>
                        </VBox>
                        <VBox styleClass="surface-card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Where it is" styleClass="section-head-title"/>
                            <StackPane VBox.vgrow="ALWAYS">
                                <WebView fx:id="mapView" prefHeight="470"/>
                            </StackPane>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- ========================== 2 · HOSPITALS ========================= -->
        <ScrollPane fx:id="pageHospitals" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="hospitalsHeroHost"/>
                <VBox styleClass="page-gutter" spacing="18">
                    <VBox styleClass="surface-card" spacing="12">
                        <TableView fx:id="nearbyHospitalTable" prefHeight="540">
                            <columns>
                                <TableColumn fx:id="nearbyHospitalNameColumn" text="Hospital" prefWidth="280"/>
                                <TableColumn fx:id="nearbyHospitalDistrictColumn" text="District" prefWidth="140"/>
                                <TableColumn fx:id="nearbyHospitalAreaColumn" text="Area" prefWidth="170"/>
                                <TableColumn fx:id="nearbyHospitalPhoneColumn" text="Phone" prefWidth="150"/>
                                <TableColumn fx:id="nearbyHospitalDistanceColumn" text="Distance" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- =========================== 3 · HISTORY ========================== -->
        <ScrollPane fx:id="pageHistory" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="historyHeroHost"/>
                <HBox fx:id="historyMetricsRow" spacing="18" styleClass="hero-overlap">
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="VERIFIED DONATIONS" styleClass="metric-label"/>
                        <Label fx:id="impactDonationsLabel" text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="UNITS DONATED" styleClass="metric-label"/>
                        <Label fx:id="impactUnitsLabel" text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="surface-card" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="HOSPITALS HELPED" styleClass="metric-label"/>
                        <Label fx:id="impactHospitalsLabel" text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="surface-card-tint" spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="YOUR RATING" styleClass="metric-label"/>
                        <Label fx:id="impactRatingLabel" text="—" styleClass="metric-value"/>
                    </VBox>
                </HBox>
                <VBox styleClass="page-gutter" spacing="18">
                    <Label fx:id="impactSinceLabel" text="—" styleClass="lede"/>
                    <VBox styleClass="surface-card" spacing="12">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Every verified donation" styleClass="section-head-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <TableView fx:id="donationTable" prefHeight="420">
                            <columns>
                                <TableColumn fx:id="donationDateColumn" text="Date" prefWidth="120"/>
                                <TableColumn fx:id="donationHospitalColumn" text="Hospital" prefWidth="260"/>
                                <TableColumn fx:id="donationBloodColumn" text="Group" prefWidth="90"/>
                                <TableColumn fx:id="donationUnitsColumn" text="Units" prefWidth="80"/>
                                <TableColumn fx:id="donationVerifiedColumn" text="Status" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- =========================== 4 · REWARDS ========================== -->
        <ScrollPane fx:id="pageRewards" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="rewardsHeroHost"/>
                <HBox spacing="18" styleClass="hero-overlap">
                    <VBox styleClass="surface-card-tint" spacing="3" prefWidth="260">
                        <Label text="POINTS BALANCE" styleClass="metric-label"/>
                        <Label fx:id="pointsBalanceLabel" text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox fx:id="rewardsBannerHost" HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox styleClass="page-gutter" spacing="18">
                    <VBox fx:id="rewardsHeadHost"/>
                    <VBox styleClass="surface-card" spacing="12">
                        <ListView fx:id="voucherList" styleClass="card-list" prefHeight="380"/>
                    </VBox>
                    <VBox styleClass="surface-card" spacing="12">
                        <Label text="Your redemptions" styleClass="section-head-title"/>
                        <ListView fx:id="redemptionHistoryList" styleClass="card-list" prefHeight="230"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- ========================= 5 · LEADERBOARD ======================== -->
        <ScrollPane fx:id="pageLeaderboard" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="leaderboardHeroHost"/>
                <VBox fx:id="leaderboardHost" styleClass="page-gutter" spacing="18"/>
            </VBox>
        </ScrollPane>

        <!-- ======================== 6 · NEWS AND IMPACT ===================== -->
        <ScrollPane fx:id="pageNews" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="newsHeroHost"/>
                <VBox styleClass="page-gutter" spacing="30">
                    <!-- Stories run the full width here rather than being
                         squeezed into a third of the home page. -->
                    <VBox fx:id="newsHost" spacing="12"/>
                    <VBox fx:id="awarenessHost" spacing="12"/>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- ======================== 7 · NOTIFICATIONS ======================= -->
        <ScrollPane fx:id="pageNotifications" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="notificationsHeroHost"/>
                <VBox styleClass="page-gutter" spacing="18">
                    <HBox alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Mark all read" styleClass="button-pill" onAction="#markAllNotificationsRead"/>
                    </HBox>
                    <VBox styleClass="surface-card" spacing="12">
                        <ListView fx:id="notificationList" styleClass="notification-list" prefHeight="520"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- ============================ 6 · HELP =========================== -->
        <ScrollPane fx:id="pageHelp" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="helpHeroHost"/>
                <VBox fx:id="helpContainer" styleClass="page-gutter" spacing="18"/>
            </VBox>
        </ScrollPane>

        <!-- =========================== 7 · PROFILE ========================== -->
        <ScrollPane fx:id="pageProfile" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="profileHeroHost"/>

                <VBox fx:id="profileSectionsHost" styleClass="page-gutter" spacing="20"/>

                <VBox fx:id="profileDetailsSection" styleClass="page-gutter" spacing="20">

                    <HBox styleClass="surface-card" spacing="22" alignment="CENTER_LEFT">
                        <StackPane onMouseClicked="#changeProfilePhoto" style="-fx-cursor: hand;">
                            <ImageView fx:id="profilePhotoView" fitWidth="96" fitHeight="96"
                                       preserveRatio="false" styleClass="avatar-photo" visible="false" managed="false">
                                <clip><Rectangle width="96" height="96" arcWidth="21" arcHeight="21"/></clip>
                            </ImageView>
                            <Label fx:id="profileInitialsLabel" styleClass="avatar-initials, avatar-initials-lg" text="?"/>
                        </StackPane>
                        <VBox spacing="8">
                            <Label text="Profile photo" styleClass="section-head-title"/>
                            <Label text="Shown to requesters on your donor card and profile."
                                   styleClass="section-head-sub" wrapText="true"/>
                            <HBox spacing="10">
                                <Button fx:id="uploadPhotoButton" text="Upload photo" styleClass="button-pill" onAction="#uploadPhoto"/>
                                <Button fx:id="removePhotoButton" text="Remove" styleClass="button-ghost" onAction="#removePhoto"/>
                            </HBox>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="3" alignment="CENTER_RIGHT">
                            <Label text="NID NUMBER" styleClass="metric-label"/>
                            <Label fx:id="nidLabel" text="Not Provided" styleClass="metric-value, metric-value-sm"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="surface-card" spacing="16">
                        <Label text="Contact information" styleClass="section-head-title"/>
                        <GridPane hgap="18" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="FULL NAME" styleClass="field-label"/>
                                <TextField fx:id="nameField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label text="EMAIL" styleClass="field-label"/>
                                <Label fx:id="emailLabel" text="" styleClass="metric-value, metric-value-sm"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label text="PHONE" styleClass="field-label"/>
                                <TextField fx:id="phoneField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label text="DISTRICT" styleClass="field-label"/>
                                <TextField fx:id="districtField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                <Label text="GUARDIAN NAME" styleClass="field-label"/>
                                <TextField fx:id="guardianNameField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <Label text="GUARDIAN PHONE" styleClass="field-label"/>
                                <TextField fx:id="guardianPhoneField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                <Label text="ADDRESS" styleClass="field-label"/>
                                <TextArea fx:id="addressArea" prefRowCount="2" wrapText="true"/>
                            </VBox>
                        </GridPane>
                        <HBox>
                            <Button text="Save contact info" styleClass="button-pill" onAction="#saveProfile"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="surface-card" spacing="16">
                        <Label text="Health details" styleClass="section-head-title"/>
                        <GridPane hgap="18" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="34"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="BLOOD GROUP" styleClass="field-label"/>
                                <Label fx:id="profileBloodGroupLabel" text="" styleClass="metric-value, metric-value-sm, metric-value-blood"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label text="WEIGHT (KG)" styleClass="field-label"/>
                                <TextField fx:id="weightField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="2">
                                <Label text="HEIGHT (CM)" styleClass="field-label"/>
                                <TextField fx:id="heightField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label text="LAST DONATION" styleClass="field-label"/>
                                <DatePicker fx:id="lastDonationPicker" maxWidth="Infinity"/>
                            </VBox>
                        </GridPane>

                        <Label text="Medical screening" styleClass="field-label"/>
                        <VBox spacing="6">
                            <Label text="Chronic conditions (if any)" styleClass="section-head-sub"/>
                            <TextField fx:id="chronicConditionsField"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Recent surgery (last 6 months)?" styleClass="section-head-sub" prefWidth="270"/>
                                <CheckBox fx:id="recentSurgeryCheck"/>
                            </HBox>
                            <TextField fx:id="recentSurgeryDetailsField" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Recent tattoo or piercing (last 6 months)?" styleClass="section-head-sub" prefWidth="270"/>
                                <CheckBox fx:id="recentTattooCheck"/>
                            </HBox>
                            <TextField fx:id="recentTattooDetailsField" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Currently taking medications?" styleClass="section-head-sub" prefWidth="270"/>
                                <CheckBox fx:id="currentMedicationsCheck"/>
                            </HBox>
                            <TextField fx:id="currentMedicationsDetailsField" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Recent infectious illness?" styleClass="section-head-sub" prefWidth="270"/>
                                <CheckBox fx:id="recentIllnessCheck"/>
                            </HBox>
                            <TextField fx:id="recentIllnessDetailsField" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Pregnancy in last 6 months?" styleClass="section-head-sub" prefWidth="270"/>
                                <CheckBox fx:id="recentPregnancyCheck"/>
                            </HBox>
                            <TextField fx:id="recentPregnancyDetailsField" managed="false" visible="false"/>
                        </VBox>
                        <HBox>
                            <Button text="Save health info" styleClass="button-pill" onAction="#saveHealth"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="surface-card" spacing="14">
                        <Label text="Reference hospital" styleClass="section-head-title"/>
                        <Label text="Optional: pick the hospital closest to where you actually are, and requesters see a precise distance to you instead of a district-level estimate."
                               styleClass="section-head-sub" wrapText="true"/>
                        <ComboBox fx:id="referenceHospitalCombo" editable="true" maxWidth="Infinity"
                                  promptText="Search hospital name..."/>
                        <Label fx:id="referenceHospitalHelperLabel" styleClass="section-head-sub" wrapText="true"/>
                        <HBox spacing="10">
                            <Button text="Save reference hospital" styleClass="button-pill" onAction="#saveReferenceHospital"/>
                            <Button text="Clear" styleClass="button-ghost" onAction="#clearReferenceHospital"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="surface-card" spacing="16">
                        <Label text="Change password" styleClass="section-head-title"/>
                        <GridPane hgap="18" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="34"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="CURRENT PASSWORD" styleClass="field-label"/>
                                <PasswordField fx:id="oldPasswordField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label text="NEW PASSWORD" styleClass="field-label"/>
                                <PasswordField fx:id="newPasswordField"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="2">
                                <Label text="CONFIRM NEW" styleClass="field-label"/>
                                <PasswordField fx:id="confirmPasswordField"/>
                            </VBox>
                        </GridPane>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Button text="Change password" styleClass="button-pill" onAction="#changePassword"/>
                            <Label fx:id="profileMessageLabel" styleClass="message-text" wrapText="true"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- =========================== 10 · ABOUT =========================== -->
        <ScrollPane fx:id="pageAbout" fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
            <VBox styleClass="page-body">
                <VBox fx:id="aboutHeroHost"/>
                <VBox fx:id="aboutHost" styleClass="page-gutter" spacing="18"/>
            </VBox>
        </ScrollPane>

    </PageHost>
</HBox>
